# Normalize line endings: LF in the repository, native (CRLF on Windows) in the working tree.
* text=auto

# Visual Studio files keep CRLF
*.sln     text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.targets text eol=crlf

# Source
*.cs      text diff=csharp
*.xaml    text
*.xshd    text
*.md      text
*.sql     text
*.json    text
*.ps1     text eol=crlf
*.sh      text eol=lf

# Binary
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.bmp  binary
*.pdf  binary
*.dll  binary
*.exe  binary
*.zip  binary
