<Window x:Class="SqlExpert.App.Views.FieldEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SqlExpert.App.Views"
        Title="Field"
        Height="640" Width="620" MinHeight="520" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="Lbl" BasedOn="{StaticResource FormLabel}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource SqlTextBox}">
      <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource SqlComboBox}">
      <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="Margin" Value="0,4"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <views:DialogHeaderBar DockPanel.Dock="Top" x:Name="HeaderText" Icon="{StaticResource Icon.Table}"/>

    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogButtonBar}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="OkButton" Style="{StaticResource DialogPrimaryButton}" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
        <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="Cancel" Width="80" IsCancel="True"/>
      </StackPanel>
    </Border>

  <Grid Margin="14,10,14,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="90"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Lbl}" Text="Field name"/>
      <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" x:Name="NameBox" TextChanged="AnyChanged"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource Lbl}" Text="Data type"/>
      <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TypeBox" SelectionChanged="TypeChanged"/>
      <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Lbl}" Margin="14,4,10,4" Text="Size / length"/>
      <DockPanel Grid.Row="1" Grid.Column="3">
        <CheckBox DockPanel.Dock="Right" x:Name="MaxBox" Content="max" Margin="8,4,0,4" Checked="AnyChanged" Unchecked="AnyChanged"/>
        <TextBox x:Name="SizeBox" TextChanged="AnyChanged"/>
      </DockPanel>

      <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource Lbl}" Text="Precision"/>
      <TextBox Grid.Row="2" Grid.Column="1" x:Name="PrecisionBox" TextChanged="AnyChanged"/>
      <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Lbl}" Margin="14,4,10,4" Text="Scale"/>
      <TextBox Grid.Row="2" Grid.Column="3" x:Name="ScaleBox" TextChanged="AnyChanged"/>

      <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource Lbl}" Text="Nullable"/>
      <CheckBox Grid.Row="3" Grid.Column="1" x:Name="NullableBox" Content="Permite NULL" Checked="AnyChanged" Unchecked="AnyChanged"/>
      <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Lbl}" Margin="14,4,10,4" Text="Primary key"/>
      <CheckBox Grid.Row="3" Grid.Column="3" x:Name="PrimaryKeyBox" Content="Chave primária" Checked="AnyChanged" Unchecked="AnyChanged"
                ToolTip="Faz o campo parte da PRIMARY KEY da tabela (o campo passa a ser NOT NULL)"/>
      <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3" x:Name="PrimaryKeyNote" TextWrapping="Wrap" Foreground="{StaticResource Ui.NoteText}"
                 Margin="0,2,0,2" Visibility="Collapsed"/>

      <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource Lbl}" Text="Default"/>
      <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="DefaultBox" FontFamily="Consolas" TextChanged="AnyChanged"
               ToolTip="Expressão T-SQL. Exemplos: 0   'ABERTO'   N'texto'   sysdatetime()   newid()"/>

      <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource Lbl}" Text="Collation"/>
      <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CollationBox" IsEditable="True"
                ToolTip="Vazio = collation padrão do banco"
                TextBoxBase.TextChanged="AnyChanged" SelectionChanged="AnyChanged">
        <ComboBox.ItemsPanel>
          <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
        </ComboBox.ItemsPanel>
      </ComboBox>

      <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource Lbl}" Text="Identity"/>
      <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
        <CheckBox x:Name="IdentityBox" Content="IDENTITY" Checked="AnyChanged" Unchecked="AnyChanged"/>
        <TextBlock Style="{StaticResource Lbl}" Margin="16,4,4,4" Text="Seed"/>
        <TextBox x:Name="SeedBox" Width="70" Text="1" TextChanged="AnyChanged"/>
        <TextBlock Style="{StaticResource Lbl}" Margin="12,4,4,4" Text="Increment"/>
        <TextBox x:Name="IncrementBox" Width="70" Text="1" TextChanged="AnyChanged"/>
      </StackPanel>

      <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource Lbl}" VerticalAlignment="Top" Margin="0,7,10,4" Text="Description"/>
      <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" x:Name="DescriptionBox" Height="54"
               AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="AnyChanged"
               ToolTip="Gravado como extended property MS_Description"/>
    </Grid>

    <DockPanel Grid.Row="1" Margin="0,10,0,0">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource FormSection}" Text="SQL que será executado (em uma transação):"/>
      <views:SqlPreviewBox x:Name="PreviewBox" MinHeight="80"/>
    </DockPanel>

    <TextBlock Grid.Row="2" x:Name="ErrorText" Style="{StaticResource FormError}" Margin="0,6,0,0"/>
  </Grid>
  </DockPanel>
</Window>
