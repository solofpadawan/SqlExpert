<Window x:Class="SqlExpert.App.Views.ReorderFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SqlExpert.App.Views"
        Title="Reorder fields"
        Height="620" Width="900" MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <DockPanel>
    <views:DialogHeaderBar DockPanel.Dock="Top" x:Name="HeaderText" Icon="{StaticResource Icon.Reorder}"/>

    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogButtonBar}">
      <DockPanel LastChildFill="False">
        <TextBlock DockPanel.Dock="Left" x:Name="StatusLine" VerticalAlignment="Center" Foreground="{StaticResource Ui.MutedText}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource DialogButton}" Content="Close" Width="80" IsCancel="True"/>
        <Button DockPanel.Dock="Right" x:Name="CopyButton" Style="{StaticResource DialogPrimaryButton}" Content="Copy script" Width="100" Margin="0,0,8,0" Click="Copy_Click"/>
      </DockPanel>
    </Border>

  <Grid Margin="14,10,14,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource FormSection}" Text="Campos (nova ordem):"/>
      <ListBox x:Name="FieldsList" SelectionChanged="FieldsList_OnSelectionChanged"/>
    </DockPanel>

    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
      <Button x:Name="TopButton" Style="{StaticResource DialogButton}" Width="84" Margin="0,2" HorizontalContentAlignment="Left" Padding="6,2" Click="Top_Click" ToolTip="Mover para o início"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.MoveTop}"/><TextBlock Text="Top" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="UpButton" Style="{StaticResource DialogButton}" Width="84" Margin="0,2" HorizontalContentAlignment="Left" Padding="6,2" Click="Up_Click" ToolTip="Mover para cima (Alt+Up)"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.MoveUp}"/><TextBlock Text="Up" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="DownButton" Style="{StaticResource DialogButton}" Width="84" Margin="0,2" HorizontalContentAlignment="Left" Padding="6,2" Click="Down_Click" ToolTip="Mover para baixo (Alt+Down)"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.MoveDown}"/><TextBlock Text="Down" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
      <Button x:Name="BottomButton" Style="{StaticResource DialogButton}" Width="84" Margin="0,2" HorizontalContentAlignment="Left" Padding="6,2" Click="Bottom_Click" ToolTip="Mover para o fim"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.MoveBottom}"/><TextBlock Text="Bottom" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
    </StackPanel>

    <DockPanel Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Style="{StaticResource FormSection}"
                 Text="Script de recriação da tabela (somente leitura — o SqlExpert NÃO executa este script):"/>
      <views:SqlPreviewBox x:Name="ScriptBox"/>
    </DockPanel>
  </Grid>
  </DockPanel>
</Window>
