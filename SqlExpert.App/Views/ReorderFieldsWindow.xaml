<Window x:Class="SqlExpert.App.Views.ReorderFieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reorder fields"
        Height="620" Width="900" MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.ColumnSpan="3" x:Name="HeaderText" TextWrapping="Wrap" Margin="0,0,0,8"/>

    <ListBox Grid.Row="1" Grid.Column="0" x:Name="FieldsList" SelectionChanged="FieldsList_OnSelectionChanged"/>

    <StackPanel Grid.Row="1" Grid.Column="1" Margin="6,0" VerticalAlignment="Center">
      <Button x:Name="TopButton" Content="Top" Width="64" Margin="0,2" Click="Top_Click" ToolTip="Mover para o início"/>
      <Button x:Name="UpButton" Content="▲ Up" Width="64" Margin="0,2" Click="Up_Click" ToolTip="Mover para cima (Alt+Up)"/>
      <Button x:Name="DownButton" Content="▼ Down" Width="64" Margin="0,2" Click="Down_Click" ToolTip="Mover para baixo (Alt+Down)"/>
      <Button x:Name="BottomButton" Content="Bottom" Width="64" Margin="0,2" Click="Bottom_Click" ToolTip="Mover para o fim"/>
    </StackPanel>

    <DockPanel Grid.Row="1" Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Margin="0,0,0,2"
                 Text="Script de recriação da tabela (somente leitura — o SqlExpert NÃO executa este script):"/>
      <TextBox x:Name="ScriptBox" IsReadOnly="True" FontFamily="Consolas" Background="#F4F4F4"
               TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
    </DockPanel>

    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" x:Name="StatusLine" VerticalAlignment="Center" Foreground="DimGray"/>
      <Button DockPanel.Dock="Right" Content="Close" Width="80" IsCancel="True"/>
      <Button DockPanel.Dock="Right" x:Name="CopyButton" Content="Copy script" Width="100" Margin="0,0,8,0" Click="Copy_Click"/>
    </DockPanel>
  </Grid>
</Window>
