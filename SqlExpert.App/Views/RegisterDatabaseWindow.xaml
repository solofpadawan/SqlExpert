<Window x:Class="SqlExpert.App.Views.RegisterDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register Database"
        Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Display name"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Name="DisplayNameBox" Text="SQL Server"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Server"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Name="ServerBox" Text="localhost"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Instance (opt.)"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Name="InstanceBox"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Port"/>
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Name="PortBox" Text="1433"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Database"/>
        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Name="DatabaseBox" Text="master"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Authentication"/>
        <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,4" Name="AuthBox" SelectedIndex="0"
                  SelectionChanged="AuthBox_OnSelectionChanged">
          <ComboBoxItem Content="Windows Authentication"/>
          <ComboBoxItem Content="SQL Server Authentication"/>
        </ComboBox>

        <TextBlock Grid.Row="6" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Login" Name="UserLabel"/>
        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Name="UserBox" IsEnabled="False"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Password" Name="PasswordLabel"/>
        <PasswordBox Grid.Row="7" Grid.Column="1" Margin="0,4" Name="PasswordBox" IsEnabled="False"/>

        <CheckBox Grid.Row="8" Grid.Column="1" Margin="0,8,0,4" Name="EncryptBox" Content="Encrypt" IsChecked="True"/>
        <CheckBox Grid.Row="9" Grid.Column="1" Margin="0,4" Name="TrustBox" Content="Trust server certificate"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Margin="0,4" VerticalAlignment="Center" Text="Timeout (s)"/>
        <TextBox Grid.Row="10" Grid.Column="1" Margin="0,4" Name="TimeoutBox" Text="15"/>

        <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   TextWrapping="Wrap" Foreground="#666"
                   Text="A senha nunca é gravada em connections.json — usa DPAPI (%AppData%/SqlExpert/secrets)."/>
      </Grid>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Name="StatusText" Margin="0,8,0,4" TextWrapping="Wrap" Foreground="#A00"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
      <Button Content="Test Connection" Width="120" Margin="0,0,8,0" Click="Test_Click"/>
      <Button Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
      <Button Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
    </StackPanel>
  </Grid>
</Window>
