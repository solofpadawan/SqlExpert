<Window x:Class="SqlExpert.App.Views.RegisterDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SqlExpert.App.Views"
        Title="Register Database"
        Height="560" Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style TargetType="TextBox" BasedOn="{StaticResource SqlTextBox}">
      <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource SqlPasswordBox}">
      <Setter Property="Margin" Value="0,3"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource SqlComboBox}">
      <Setter Property="Margin" Value="0,3"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <views:DialogHeaderBar DockPanel.Dock="Top" x:Name="HeaderBar" Title="Register Database"
                           Subtitle="Servidor SQL Server, banco inicial e forma de autenticação."
                           Icon="{StaticResource Icon.RegisterDatabase}"/>

    <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogButtonBar}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource DialogButton}" Content="Test Connection" Width="120" Click="Test_Click"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource DialogPrimaryButton}" Content="OK" Width="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
          <Button Style="{StaticResource DialogButton}" Content="Cancel" Width="80" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

  <Grid Margin="14,10,14,6">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="140"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Display name"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="DisplayNameBox" Text="SQL Server"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Server"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="ServerBox" Text="localhost"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Instance (opt.)"/>
        <TextBox Grid.Row="2" Grid.Column="1" Name="InstanceBox"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Port"/>
        <TextBox Grid.Row="3" Grid.Column="1" Name="PortBox" Text="1433"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Database"/>
        <TextBox Grid.Row="4" Grid.Column="1" Name="DatabaseBox" Text="master"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Authentication"/>
        <ComboBox Grid.Row="5" Grid.Column="1" Name="AuthBox" SelectedIndex="0"
                  SelectionChanged="AuthBox_OnSelectionChanged">
          <ComboBoxItem Content="Windows Authentication"/>
          <ComboBoxItem Content="SQL Server Authentication"/>
        </ComboBox>

        <TextBlock Grid.Row="6" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Login" Name="UserLabel"/>
        <TextBox Grid.Row="6" Grid.Column="1" Name="UserBox" IsEnabled="False"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Password" Name="PasswordLabel"/>
        <PasswordBox Grid.Row="7" Grid.Column="1" Name="PasswordBox" IsEnabled="False"/>

        <CheckBox Grid.Row="8" Grid.Column="1" Margin="0,8,0,4" Name="EncryptBox" Content="Encrypt" IsChecked="True"/>
        <CheckBox Grid.Row="9" Grid.Column="1" Margin="0,4" Name="TrustBox" Content="Trust server certificate"/>

        <TextBlock Grid.Row="10" Grid.Column="0" Style="{StaticResource FormLabel}" Text="Timeout (s)"/>
        <TextBox Grid.Row="10" Grid.Column="1" Name="TimeoutBox" Text="15"/>

        <TextBlock Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                   Style="{StaticResource FormHint}"
                   Text="A senha nunca é gravada em connections.json — usa DPAPI (%AppData%/SqlExpert/secrets)."/>
      </Grid>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Name="StatusText" Margin="0,8,0,4" Style="{StaticResource FormError}"/>
  </Grid>
  </DockPanel>
</Window>
