<UserControl x:Class="SqlExpert.App.Views.SqlEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SqlExpert.App.Views"
             xmlns:ae="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:svc="clr-namespace:SqlExpert.App.Services"
             PreviewKeyDown="OnPreviewKeyDown">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="SqlBoolToVis"/>
    <!-- Flat toolbar buttons (Themes/Controls.xaml): icon + caption -->
    <Style x:Key="SqlTbButton" TargetType="Button" BasedOn="{StaticResource FlatToolButton}"/>
    <!-- "<null>" in red (NullValueBrush, Resources/Branding.xaml), classic style -->
    <Style x:Key="SqlCellText" TargetType="TextBlock" BasedOn="{StaticResource NullAwareCellText}">
      <Setter Property="Padding" Value="2,0"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="SqlCellTextRight" TargetType="TextBlock" BasedOn="{StaticResource SqlCellText}">
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>
    <DataTemplate x:Key="SqlMessageTemplate">
      <TextBlock x:Name="Msg" Text="{Binding Text, Mode=OneWay}" TextWrapping="Wrap" Margin="2,1" FontFamily="Consolas"/>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="Error">
          <Setter TargetName="Msg" Property="Foreground" Value="#B00000"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="RowsAffected">
          <Setter TargetName="Msg" Property="Foreground" Value="#606060"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind, Mode=OneWay}" Value="Status">
          <Setter TargetName="Msg" Property="Foreground" Value="#1F4E8C"/>
          <Setter TargetName="Msg" Property="FontStyle" Value="Italic"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Style="{StaticResource InnerToolBarBand}">
    <ToolBarTray IsLocked="True" Background="Transparent">
      <ToolBar ToolBarTray.IsLocked="True" Style="{StaticResource InnerTrayToolBar}">
        <Button Style="{StaticResource SqlTbButton}" FontWeight="Bold"
                ToolTip="Executar (F9 / Ctrl+Enter). Com seleção, executa só o texto selecionado." Command="{Binding ExecuteCommand}"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.Execute}"/><TextBlock Text="Execute" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource SqlTbButton}"
                ToolTip="Cancelar a execução (Ctrl+Break)" Command="{Binding CancelCommand}"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.Stop}"/><TextBlock Text="Stop" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
        <Separator/>
        <CheckBox Content="Autocommit" VerticalAlignment="Center" Margin="4,0"
                  ToolTip="Ligado: cada comando confirma sozinho. Desligado: a transação fica aberta até Commit/Rollback."
                  IsChecked="{Binding Autocommit, Mode=TwoWay}" IsEnabled="{Binding IsIdle, Mode=OneWay}"/>
        <Button Style="{StaticResource SqlTbButton}" ToolTip="COMMIT da transação aberta" Command="{Binding CommitCommand}"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.Commit}"/><TextBlock Text="Commit" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
        <Button Style="{StaticResource SqlTbButton}" ToolTip="ROLLBACK da transação aberta" Command="{Binding RollbackCommand}"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.Rollback}"/><TextBlock Text="Rollback" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
        <Separator/>
        <TextBlock Text="Fetch first:" VerticalAlignment="Center" Margin="4,0,2,0"/>
        <TextBox x:Name="FetchBox" Width="64" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                 ToolTip="Registros mantidos por resultado (padrão 1000). Enter aplica."
                 Text="{Binding FetchRows, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                 KeyDown="FetchBox_OnKeyDown"/>
        <Button Style="{StaticResource SqlTbButton}" ToolTip="Executa de novo sem limite de registros" Command="{Binding FetchAllCommand}"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.FetchAll}"/><TextBlock Text="Fetch all" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
        <Separator/>
        <CheckBox Content="Plan" VerticalAlignment="Center" Margin="4,0"
                  ToolTip="Coleta o plano de execução real e os números do servidor (Plan / Performance info na aba Messages)"
                  IsChecked="{Binding CapturePlan, Mode=TwoWay}" IsEnabled="{Binding IsIdle, Mode=OneWay}"/>
        <Separator/>
        <Button Style="{StaticResource FlatIconButton}" ToolTip="Load from File (Ctrl+O)" Command="{Binding OpenCommand}"><views:IconImage Icon="{StaticResource Icon.LoadFromFile}"/></Button>
        <Button Style="{StaticResource FlatIconButton}" ToolTip="Save to File (Ctrl+S)" Command="{Binding SaveCommand}"><views:IconImage Icon="{StaticResource Icon.SaveToFile}"/></Button>
        <Button Style="{StaticResource FlatIconButton}" ToolTip="Save as..." Command="{Binding SaveAsCommand}"><views:IconImage Icon="{StaticResource Icon.SaveAs}"/></Button>
        <Separator/>
        <Button Style="{StaticResource FlatIconButton}" ToolTip="Find (Ctrl+F, F3 / Shift+F3)" Click="Find_OnClick"><views:IconImage Icon="{StaticResource Icon.Find}"/></Button>
        <Button Style="{StaticResource FlatIconButton}" ToolTip="Replace (Ctrl+R / Ctrl+H)" Click="Replace_OnClick"><views:IconImage Icon="{StaticResource Icon.Replace}"/></Button>
        <Separator/>
        <TextBlock Text="Font size:" VerticalAlignment="Center" Margin="4,0,3,0"/>
        <Grid VerticalAlignment="Center" Height="22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34"/>
            <ColumnDefinition Width="15"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBox x:Name="FontSizeBox" Grid.RowSpan="2" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                   MaxLength="2" ToolTip="Fonte do editor (6–32). Enter aplica; Ctrl+roda do mouse no editor também altera."
                   KeyDown="FontSizeBox_OnKeyDown" LostKeyboardFocus="FontSizeBox_OnLostKeyboardFocus"/>
          <RepeatButton Grid.Column="1" Grid.Row="0" Padding="0" FontSize="6" Content="▲" Focusable="False" ToolTip="Aumentar fonte" Click="FontUp_OnClick"/>
          <RepeatButton Grid.Column="1" Grid.Row="1" Padding="0" FontSize="6" Content="▼" Focusable="False" ToolTip="Diminuir fonte" Click="FontDown_OnClick"/>
        </Grid>
        <TextBlock Text="executando..." VerticalAlignment="Center" Margin="8,0" Foreground="#B25F00" FontWeight="SemiBold"
                   Visibility="{Binding IsExecuting, Mode=OneWay, Converter={StaticResource SqlBoolToVis}}"/>
      </ToolBar>
    </ToolBarTray>
    </Border>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock Text="{Binding CaretText, Mode=OneWay}" MinWidth="70"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock x:Name="TranText" Text="{Binding TransactionText, Mode=OneWay}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding InTransaction, Mode=OneWay}" Value="True">
                  <Setter Property="Foreground" Value="#B00000"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock Text="{Binding CurrentDatabase, Mode=OneWay}" ToolTip="Database da sessão deste editor"/>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock Text="{Binding StatusLine, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" MinHeight="80"/>
        <RowDefinition Height="5"/>
        <RowDefinition Height="200" MinHeight="50"/>
      </Grid.RowDefinitions>

      <!-- Upper pages (classic order). Plan Analyzer / Performance Analysis / Logs: layout only, greyed (CommandAvailability). -->
      <TabControl x:Name="PageTabs" Grid.Row="0" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}">
        <TabItem Header="Edit" Tag="sqleditor.page.edit" ToolTip="Texto SQL (Ctrl+Espaço completa nomes; duplo clique num nome sublinhado abre o objeto)">
          <ae:TextEditor x:Name="Editor"
                         Document="{Binding Document, Mode=OneWay}"
                         FontFamily="Consolas"
                         FontSize="{Binding Source={x:Static svc:UiSettings.Instance}, Path=SqlEditorFontSizePx, Mode=OneWay}"
                         ShowLineNumbers="True" WordWrap="False"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         PreviewMouseWheel="Editor_OnPreviewMouseWheel"/>
        </TabItem>
        <TabItem Header="Results" Tag="sqleditor.page.results" ToolTip="Resultado do último SELECT (editável quando vem de uma tabela com chave)">
          <ContentControl x:Name="ResultsHost" Focusable="False"/>
        </TabItem>
      <TabItem Header="History" Tag="sqleditor.page.history" ToolTip="Últimos comandos executados nesta conexão">
        <DockPanel>
          <ToolBar DockPanel.Dock="Top" Style="{StaticResource InnerToolBar}">
            <Button Style="{StaticResource SqlTbButton}" ToolTip="Insere o comando na posição do cursor (Enter / duplo clique)"
                    Command="{Binding InsertHistoryCommand}"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.Paste}"/><TextBlock Text="Inserir no editor" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button Style="{StaticResource SqlTbButton}" ToolTip="Substitui todo o texto do editor pelo comando"
                    Command="{Binding ReplaceWithHistoryCommand}"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.Replace}"/><TextBlock Text="Substituir texto" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <Button Style="{StaticResource SqlTbButton}" ToolTip="Copia o comando para a área de transferência"
                    Command="{Binding CopyHistoryCommand}"><StackPanel Orientation="Horizontal"><views:IconImage Icon="{StaticResource Icon.Copy}"/><TextBlock Text="Copiar" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
            <TextBlock VerticalAlignment="Center" Margin="8,0" Foreground="#606060"
                       Text="Últimos 100 comandos executados nesta conexão"/>
          </ToolBar>
          <TextBox DockPanel.Dock="Bottom" Height="120" IsReadOnly="True" FontFamily="Consolas" Background="#FAFAFA"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                   Text="{Binding SelectedHistory.Sql, Mode=OneWay}"/>
          <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                    SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                    MouseDoubleClick="HistoryGrid_OnMouseDoubleClick" PreviewKeyDown="HistoryGrid_OnPreviewKeyDown">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Executado em" Binding="{Binding ExecutedAtText, Mode=OneWay}" Width="130"/>
              <DataGridTextColumn Header="Database" Binding="{Binding Database, Mode=OneWay}" Width="120"/>
              <DataGridTextColumn Header="Tempo" Binding="{Binding ElapsedText, Mode=OneWay}" Width="70"/>
              <DataGridTextColumn Header="Status" Binding="{Binding StatusText, Mode=OneWay}" Width="50"/>
              <DataGridTextColumn Header="SQL" Binding="{Binding Preview, Mode=OneWay}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
        <TabItem Header="Plan Analyzer" Tag="sqleditor.page.plan_analyzer" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Plan Analyzer: ainda não implementado"/>
        <TabItem Header="Performance Analysis" Tag="sqleditor.page.performance_analysis" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Performance Analysis: ainda não implementado"/>
        <TabItem Header="Logs" Tag="sqleditor.page.logs" IsEnabled="False" ToolTipService.ShowOnDisabled="True" ToolTip="Logs: ainda não implementado"/>
      </TabControl>

      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" ResizeDirection="Rows" Background="#D4D4D4"/>

      <!-- Bottom panel: Messages (plan, performance info, server messages) | Query columns of the shown result. -->
      <TabControl x:Name="BottomTabs" Grid.Row="2" SelectedIndex="{Binding SelectedBottomTab, Mode=TwoWay}">
        <TabItem x:Name="MessagesTab" Header="Messages" Tag="sqleditor.panel.messages"/>
        <TabItem Header="Query columns" Tag="sqleditor.panel.query_columns" ToolTip="Colunas do resultado mostrado: tipo, tamanho, NULL e tabela de origem">
          <DataGrid x:Name="QueryColumnsGrid" ItemsSource="{Binding QueryColumns, Mode=OneWay}"
                    AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                    SelectionMode="Extended" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="All"
                    BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding Index, Mode=OneWay}" Width="34"/>
              <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="180"/>
              <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" Width="140"/>
              <DataGridTextColumn Header="Size" Binding="{Binding Size, Mode=OneWay}" Width="60"/>
              <DataGridTextColumn Header="Nullable" Binding="{Binding Nullable, Mode=OneWay}" Width="60"/>
              <DataGridTextColumn Header="Key" Binding="{Binding Key, Mode=OneWay}" Width="70"/>
              <DataGridTextColumn Header="Source" Binding="{Binding Source, Mode=OneWay}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
