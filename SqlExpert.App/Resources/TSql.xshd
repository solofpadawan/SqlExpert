      <Word>RULE</Word>
      <Word>SAVE</Word>
      <Word>SCHEMA</Word>
      <Word>SECURITYAUDIT</Word>
      <Word>SELECT</Word>
      <Word>SEMANTICKEYPHRASETABLE</Word>
      <Word>SEQUENCE</Word>
      <Word>SESSION_USER</Word>
      <Word>SET</Word>
      <Word>SETUSER</Word>
      <Word>SHUTDOWN</Word>
      <Word>SOME</Word>
      <Word>STATISTICS</Word>
      <Word>SYNONYM</Word>
      <Word>SYSTEM_USER</Word>
      <Word>TABLE</Word>
      <Word>TABLESAMPLE</Word>
