      <Word>LEN</Word>
      <Word>LOWER</Word>
      <Word>LTRIM</Word>
      <Word>MIN</Word>
      <Word>MONTH</Word>
      <Word>NEWID</Word>
      <Word>NEWSEQUENTIALID</Word>
      <Word>NTILE</Word>
      <Word>NULLIF</Word>
      <Word>OBJECT_ID</Word>
      <Word>OBJECT_NAME</Word>
      <Word>OBJECT_SCHEMA_NAME</Word>
      <Word>OPENJSON</Word>
      <Word>PATINDEX</Word>
      <Word>QUOTENAME</Word>
      <Word>RANK</Word>
      <Word>REPLACE</Word>
      <Word>REPLICATE</Word>
      <Word>REVERSE</Word>
      <Word>ROUND</Word>
      <Word>ROW_NUMBER</Word>
      <Word>RTRIM</Word>
      <Word>SCHEMA_NAME</Word>
      <Word>SCOPE_IDENTITY</Word>
      <Word>SERVERPROPERTY</Word>
      <Word>SIGN</Word>
      <Word>SPACE</Word>
      <Word>SQRT</Word>
      <Word>STDEV</Word>
      <Word>STRING_AGG</Word>
      <Word>STRING_SPLIT</Word>
      <Word>STR</Word>
      <Word>STUFF</Word>
      <Word>SUBSTRING</Word>
      <Word>SUM</Word>
      <Word>SUSER_SNAME</Word>
      <Word>SWITCHOFFSET</Word>
      <Word>SYSDATETIME</Word>
      <Word>SYSDATETIMEOFFSET</Word>
      <Word>SYSUTCDATETIME</Word>
      <Word>TRANSLATE</Word>
      <Word>TRIM</Word>
      <Word>TRY_CAST</Word>
      <Word>TRY_PARSE</Word>
      <Word>TYPE_NAME</Word>
      <Word>UPPER</Word>
      <Word>USER_NAME</Word>
      <Word>VAR</Word>
      <Word>YEAR</Word>
    </Keywords>

    <Rule color="Variable">@@?[A-Za-z_][A-Za-z0-9_@#$]*</Rule>
    <Rule color="TempTable">\#\#?[A-Za-z_][A-Za-z0-9_@#$]*</Rule>
    <Rule color="SystemObject">\b(sys|INFORMATION_SCHEMA)\.[A-Za-z_][A-Za-z0-9_]*</Rule>
    <Rule color="SystemObject">\b(sp|xp)_[A-Za-z0-9_]+</Rule>
    <Rule color="Number">\b0x[0-9A-Fa-f]*|(\b\d+(\.\d*)?|\.\d+)([eE][+-]?\d+)?</Rule>
    <Rule color="Operator">[-+*/%=&lt;&gt;!&amp;|^~]</Rule>
  </RuleSet>
</SyntaxDefinition>
