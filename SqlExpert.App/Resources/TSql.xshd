      <Word>OVER</Word>
      <Word>PARTITION</Word>
      <Word>PERCENT</Word>
      <Word>PIVOT</Word>
      <Word>PLAN</Word>
      <Word>PRIMARY</Word>
      <Word>PRINT</Word>
      <Word>PROC</Word>
      <Word>PROCEDURE</Word>
      <Word>PUBLIC</Word>
      <Word>RAISERROR</Word>
      <Word>READ</Word>
      <Word>READTEXT</Word>
      <Word>RECONFIGURE</Word>
      <Word>REFERENCES</Word>
