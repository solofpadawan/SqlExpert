      <Word>THEN</Word>
      <Word>THROW</Word>
      <Word>TIES</Word>
      <Word>TO</Word>
      <Word>TOP</Word>
      <Word>TRAN</Word>
      <Word>TRANSACTION</Word>
      <Word>TRIGGER</Word>
      <Word>TRUNCATE</Word>
      <Word>TRY</Word>
      <Word>TRY_CONVERT</Word>
      <Word>TSEQUAL</Word>
      <Word>TYPE</Word>
      <Word>UNION</Word>
      <Word>UNIQUE</Word>
      <Word>UNPIVOT</Word>
      <Word>UPDATE</Word>
      <Word>UPDATETEXT</Word>
      <Word>USE</Word>
      <Word>USER</Word>
      <Word>VALUES</Word>
      <Word>VARYING</Word>
      <Word>VIEW</Word>
      <Word>WAITFOR</Word>
      <Word>WHEN</Word>
      <Word>WHERE</Word>
      <Word>WHILE</Word>
      <Word>WITH</Word>
      <Word>WITHIN</Word>
      <Word>WRITETEXT</Word>
      <Word>XACT_ABORT</Word>
      <Word>GO</Word>
      <Word>NEXT</Word>
      <Word>VALUE</Word>
    </Keywords>
    <Keywords color="DataType">
      <Word>BIGINT</Word>
      <Word>BINARY</Word>
      <Word>BIT</Word>
      <Word>CHAR</Word>
      <Word>DATE</Word>
      <Word>DATETIME</Word>
