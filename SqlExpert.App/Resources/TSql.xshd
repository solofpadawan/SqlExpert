      <Word>MONEY</Word>
      <Word>NCHAR</Word>
      <Word>NTEXT</Word>
      <Word>NUMERIC</Word>
      <Word>NVARCHAR</Word>
      <Word>REAL</Word>
      <Word>SMALLDATETIME</Word>
      <Word>SMALLINT</Word>
      <Word>SMALLMONEY</Word>
      <Word>SQL_VARIANT</Word>
      <Word>SYSNAME</Word>
      <Word>TEXT</Word>
      <Word>TIME</Word>
      <Word>TIMESTAMP</Word>
      <Word>ROWVERSION</Word>
      <Word>TINYINT</Word>
      <Word>UNIQUEIDENTIFIER</Word>
      <Word>VARBINARY</Word>
      <Word>VARCHAR</Word>
      <Word>XML</Word>
      <Word>MAX</Word>
    </Keywords>
    <Keywords color="Function">
      <Word>ABS</Word>
      <Word>AVG</Word>
      <Word>CAST</Word>
      <Word>CEILING</Word>
      <Word>CHARINDEX</Word>
      <Word>CHOOSE</Word>
      <Word>COALESCE</Word>
      <Word>CONCAT</Word>
      <Word>CONCAT_WS</Word>
      <Word>CONVERT</Word>
      <Word>COUNT</Word>
      <Word>COUNT_BIG</Word>
      <Word>CURRENT_TIMESTAMP</Word>
      <Word>DATEADD</Word>
      <Word>DATEDIFF</Word>
      <Word>DATEDIFF_BIG</Word>
      <Word>DATEFROMPARTS</Word>
      <Word>DATENAME</Word>
      <Word>DATEPART</Word>
      <Word>DAY</Word>
      <Word>DB_ID</Word>
