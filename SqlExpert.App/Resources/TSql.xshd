      <Word>OF</Word>
      <Word>OFF</Word>
      <Word>OFFSET</Word>
      <Word>OFFSETS</Word>
      <Word>ON</Word>
      <Word>ONLY</Word>
      <Word>OPEN</Word>
      <Word>OPENDATASOURCE</Word>
      <Word>OPENQUERY</Word>
      <Word>OPENROWSET</Word>
      <Word>OPENXML</Word>
      <Word>OPTION</Word>
      <Word>OR</Word>
      <Word>ORDER</Word>
      <Word>OUTER</Word>
