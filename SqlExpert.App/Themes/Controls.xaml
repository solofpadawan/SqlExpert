<!--
  SqlExpert control styles: folder-style tabs, flat inner toolbars, document title bars and dialog buttons.
  One soft blue-gray palette (no green). Every template snaps to device pixels so lines stay crisp at
  100% / 125% / 150% display scaling.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:SqlExpert.App.Views">

  <views:IconKeyConverter x:Key="InnerIconKeyToImage"/>

  <!-- ================================================================ palette -->
  <SolidColorBrush x:Key="Ui.Border" Color="#A9B6C8"/>
  <SolidColorBrush x:Key="Ui.BorderHover" Color="#8FA6C4"/>
  <SolidColorBrush x:Key="Ui.BorderDisabled" Color="#CBD3DE"/>
  <SolidColorBrush x:Key="Ui.Text" Color="#1F2B3A"/>
  <SolidColorBrush x:Key="Ui.TextInactive" Color="#4A5A70"/>
  <SolidColorBrush x:Key="Ui.TextDisabled" Color="#A3ACB9"/>
  <SolidColorBrush x:Key="Ui.TitleText" Color="#26374E"/>
  <SolidColorBrush x:Key="Ui.Accent" Color="#5B84B8"/>
  <SolidColorBrush x:Key="Ui.HoverFill" Color="#DCE8F7"/>
  <SolidColorBrush x:Key="Ui.HoverBorder" Color="#9DB9E0"/>
  <SolidColorBrush x:Key="Ui.PressedFill" Color="#C6D9F1"/>
  <SolidColorBrush x:Key="Ui.PressedBorder" Color="#7FA2D2"/>
  <SolidColorBrush x:Key="Tab.StripBackground" Color="#E8EDF4"/>
  <SolidColorBrush x:Key="Tab.DisabledBackground" Color="#EEF1F5"/>
  <LinearGradientBrush x:Key="Tab.InactiveBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F4F7FB" Offset="0"/>
    <GradientStop Color="#DCE4EE" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Tab.HoverBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FBFDFF" Offset="0"/>
    <GradientStop Color="#E2ECF8" Offset="1"/>
  </LinearGradientBrush>
  <!-- Tabs pointing down (bottom strips): same colors, light side towards the content. -->
  <LinearGradientBrush x:Key="Tab.InactiveBackgroundDown" StartPoint="0,1" EndPoint="0,0">
    <GradientStop Color="#F4F7FB" Offset="0"/>
    <GradientStop Color="#DCE4EE" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Tab.HoverBackgroundDown" StartPoint="0,1" EndPoint="0,0">
    <GradientStop Color="#FBFDFF" Offset="0"/>
    <GradientStop Color="#E2ECF8" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DocTitle.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F6F8FB" Offset="0"/>
    <GradientStop Color="#E6EBF2" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="InnerToolBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FAFBFD" Offset="0"/>
    <GradientStop Color="#EEF2F7" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="InnerToolBar.Border" Color="#D5DDE8"/>
  <LinearGradientBrush x:Key="Button.PressedShade" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2E28466E" Offset="0"/>
    <GradientStop Color="#0028466E" Offset="0.3"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="DialogButton.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FDFEFF" Offset="0"/>
    <GradientStop Color="#EEF2F7" Offset="1"/>
  </LinearGradientBrush>
  <!-- 2px dot grid of the toolbar gripper -->
  <DrawingBrush x:Key="InnerToolBar.GripperDots" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute"
                Viewbox="0,0,2,2" ViewboxUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent" Geometry="M0,0 H2 V2 H0 Z"/>
        <GeometryDrawing Brush="#9AA8BB" Geometry="M0,0 H1 V1 H0 Z"/>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- ================================================================ folder-style tabs (implicit) -->
  <Style TargetType="TabControl">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ui.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid x:Name="Root" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="StripRow" Height="Auto"/>
              <RowDefinition x:Name="ContentRow" Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="Strip" Grid.Row="0" Panel.ZIndex="1" Background="{StaticResource Tab.StripBackground}" Padding="4,4,4,0">
              <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Background="Transparent" KeyboardNavigation.TabIndex="1"/>
            </Border>
            <Border x:Name="ContentPanel" Grid.Row="1"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2"
                    KeyboardNavigation.TabNavigation="Local">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"
                                Margin="{TemplateBinding Padding}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TabStripPlacement" Value="Bottom">
              <Setter TargetName="Strip" Property="Grid.Row" Value="1"/>
              <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0"/>
              <Setter TargetName="StripRow" Property="Height" Value="*"/>
              <Setter TargetName="ContentRow" Property="Height" Value="Auto"/>
              <Setter TargetName="Strip" Property="Padding" Value="4,0,4,4"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ui.TextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource Ui.TextInactive}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <!-- TabControl copies these to the selected page's host: the page fills the panel. -->
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Grid x:Name="Root" Height="22" Margin="0,0,2,0" VerticalAlignment="Bottom" SnapsToDevicePixels="True">
            <Border x:Name="Bd" CornerRadius="4,4,0,0" BorderThickness="1,1,1,0"
                    BorderBrush="{StaticResource Ui.Border}" Background="{StaticResource Tab.InactiveBackground}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="Cp" ContentSource="Header" RecognizesAccessKey="True"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                SnapsToDevicePixels="True"/>
            </Border>
            <!-- 2px accent line inside the active tab -->
            <Border x:Name="Accent" Height="2" VerticalAlignment="Top" Margin="1,1,1,0" CornerRadius="3,3,0,0"
                    Background="{StaticResource Ui.Accent}" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="TabStripPlacement" Value="Bottom">
              <Setter TargetName="Root" Property="VerticalAlignment" Value="Top"/>
              <Setter TargetName="Bd" Property="CornerRadius" Value="0,0,4,4"/>
              <Setter TargetName="Bd" Property="BorderThickness" Value="1,0,1,1"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tab.InactiveBackgroundDown}"/>
              <Setter TargetName="Accent" Property="VerticalAlignment" Value="Bottom"/>
              <Setter TargetName="Accent" Property="Margin" Value="1,0,1,1"/>
              <Setter TargetName="Accent" Property="CornerRadius" Value="0,0,3,3"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsSelected" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.BorderHover}"/>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tab.HoverBackground}"/>
              <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsSelected" Value="False"/>
                <Condition Property="TabStripPlacement" Value="Bottom"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tab.HoverBackgroundDown}"/>
            </MultiTrigger>
            <!-- Active: white, 3px taller, 1px wider on each side (over its neighbours, so widths never jump),
                 joined to the content panel (overlaps its border by 1px) -->
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Panel.ZIndex" Value="1"/>
              <Setter TargetName="Root" Property="Height" Value="25"/>
              <Setter TargetName="Root" Property="Margin" Value="0,0,2,-1"/>
              <Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/>
              <Setter TargetName="Bd" Property="Margin" Value="-1,0,-1,0"/>
              <Setter TargetName="Accent" Property="Margin" Value="0,1,0,0"/>
              <Setter TargetName="Accent" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsSelected" Value="True"/>
                <Condition Property="TabStripPlacement" Value="Bottom"/>
              </MultiTrigger.Conditions>
              <Setter TargetName="Root" Property="Margin" Value="0,-1,2,0"/>
              <Setter TargetName="Accent" Property="Margin" Value="0,0,0,1"/>
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Tab.DisabledBackground}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.BorderDisabled}"/>
              <Setter TargetName="Accent" Property="Visibility" Value="Collapsed"/>
              <Setter Property="Foreground" Value="{StaticResource Ui.TextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ document title bar -->
  <Style x:Key="DocTitleBar" TargetType="Border">
    <Setter Property="Height" Value="22"/>
    <Setter Property="Background" Value="{StaticResource DocTitle.Background}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ui.Border}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
  </Style>
  <Style x:Key="DocTitleText" TargetType="TextBlock">
    <Setter Property="Margin" Value="6,0"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Ui.TitleText}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <!-- Small "✕" of the title bars -->
  <Style x:Key="TitleCloseButton" TargetType="Button">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Margin" Value="2,0,3,0"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="{StaticResource Ui.TextInactive}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.HoverFill}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.HoverBorder}"/>
              <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.PressedFill}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.PressedBorder}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ flat toolbar buttons -->
  <!-- Content: 16px views:IconImage + 5px gap + caption (or icon only). Disabled: grey text, grey icon at ~45%. -->
  <Style x:Key="FlatToolButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinWidth" Value="24"/>
    <Setter Property="Padding" Value="5,0,7,0"/>
    <Setter Property="Margin" Value="0,0,2,0"/>
    <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Shade" CornerRadius="2" Background="{StaticResource Button.PressedShade}" Visibility="Collapsed"/>
              <ContentPresenter x:Name="Cp" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="True"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.HoverFill}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.HoverBorder}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.HoverBorder}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.PressedFill}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.PressedBorder}"/>
              <Setter TargetName="Shade" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Cp" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="1"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Ui.TextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Icon-only variant (navigator, side buttons, main toolbar) -->
  <Style x:Key="FlatIconButton" TargetType="Button" BasedOn="{StaticResource FlatToolButton}">
    <Setter Property="Padding" Value="3,0"/>
  </Style>

  <!-- 1px #C3CDDA + 1px white highlight -->
  <Style x:Key="FlatToolSeparator" TargetType="Separator">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="4,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Grid Width="2" Height="18" VerticalAlignment="Center" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Rectangle Width="1" HorizontalAlignment="Left" Fill="#C3CDDA"/>
            <Rectangle Width="1" HorizontalAlignment="Right" Fill="#FFFFFF"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="InnerToolBarOverflowButton" TargetType="ToggleButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Bd" Width="14" Height="24" CornerRadius="3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
            <Path Data="M0,0 H6 L3,3.5 Z" Fill="#43607E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.HoverFill}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.HoverBorder}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.PressedFill}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.PressedBorder}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Inner toolbar (editor pages): gradient band, dotted gripper, flat buttons and separators. -->
  <Style x:Key="InnerToolBar" TargetType="ToolBar">
    <Style.Resources>
      <Style x:Key="{x:Static ToolBar.ButtonStyleKey}" TargetType="Button" BasedOn="{StaticResource FlatToolButton}"/>
      <Style x:Key="{x:Static ToolBar.SeparatorStyleKey}" TargetType="Separator" BasedOn="{StaticResource FlatToolSeparator}"/>
    </Style.Resources>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="4,0"/>
    <Setter Property="Background" Value="{StaticResource InnerToolBar.Background}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InnerToolBar.Border}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolBar">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <DockPanel>
              <Rectangle x:Name="Gripper" DockPanel.Dock="Left" Width="3" Height="16" Margin="0,0,5,0" VerticalAlignment="Center"
                         Fill="{StaticResource InnerToolBar.GripperDots}" SnapsToDevicePixels="True"/>
              <Grid x:Name="OverflowGrid" DockPanel.Dock="Right" Margin="2,0,0,0" VerticalAlignment="Center">
                <ToggleButton x:Name="OverflowButton" Style="{StaticResource InnerToolBarOverflowButton}" ClickMode="Press"
                              IsChecked="{Binding IsOverflowOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Popup x:Name="OverflowPopup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False" Focusable="False"
                       PopupAnimation="Fade" IsOpen="{Binding IsOverflowOpen, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border Background="#FAFBFD" BorderBrush="{StaticResource Ui.Border}" BorderThickness="1" Padding="2">
                    <ToolBarOverflowPanel x:Name="PART_ToolBarOverflowPanel" WrapWidth="200" FocusVisualStyle="{x:Null}"
                                          Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
                                          KeyboardNavigation.DirectionalNavigation="Cycle"/>
                  </Border>
                </Popup>
              </Grid>
              <ToolBarPanel x:Name="PART_ToolBarPanel" IsItemsHost="True" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="HasOverflowItems" Value="False">
              <Setter TargetName="OverflowGrid" Property="Visibility" Value="Collapsed"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Same toolbar inside a ToolBarTray: the tray (wrapped in InnerToolBarBand) draws the band and its bottom line. -->
  <Style x:Key="InnerTrayToolBar" TargetType="ToolBar" BasedOn="{StaticResource InnerToolBar}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="InnerToolBarBand" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource InnerToolBar.Background}"/>
    <Setter Property="BorderBrush" Value="{StaticResource InnerToolBar.Border}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- CommandMenuItem rows of the table editor toolbars (Fields, Constraints, ...): icon + caption, or a separator. -->
  <DataTemplate x:Key="InnerToolbarCommandTemplate">
    <Grid>
      <Button x:Name="Btn" Style="{StaticResource FlatToolButton}" ToolTip="{Binding ToolTip}" Command="{Binding Command}">
        <StackPanel Orientation="Horizontal">
          <views:IconImage x:Name="Ico" VerticalAlignment="Center"
                           Icon="{Binding IconKey, Mode=OneWay, Converter={StaticResource InnerIconKeyToImage}}"/>
          <TextBlock x:Name="Caption" Text="{Binding Caption}" Margin="5,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Separator x:Name="Sep" Style="{StaticResource FlatToolSeparator}" Visibility="Collapsed"/>
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsSeparator}" Value="True">
        <Setter TargetName="Btn" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="Sep" Property="Visibility" Value="Visible"/>
      </DataTrigger>
      <DataTrigger Binding="{Binding IconKey}" Value="{x:Null}">
        <Setter TargetName="Ico" Property="Visibility" Value="Collapsed"/>
        <Setter TargetName="Caption" Property="Margin" Value="0"/>
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- ================================================================ dialog buttons (OK / Cancel / ...) -->
  <Style x:Key="DialogButton" TargetType="Button">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="MinHeight" Value="23"/>
    <Setter Property="Padding" Value="10,2"/>
    <Setter Property="Foreground" Value="{StaticResource Ui.Text}"/>
    <Setter Property="Background" Value="{StaticResource DialogButton.Background}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Ui.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" CornerRadius="3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <Grid>
              <Border x:Name="Shade" CornerRadius="2" Background="{StaticResource Button.PressedShade}" Visibility="Collapsed"/>
              <ContentPresenter x:Name="Cp" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="True"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsDefault" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.Accent}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.Accent}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.HoverFill}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.HoverBorder}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ui.PressedFill}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.PressedBorder}"/>
              <Setter TargetName="Shade" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Cp" Property="RenderTransform">
                <Setter.Value>
                  <TranslateTransform Y="1"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Background" Value="#F3F5F8"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ui.BorderDisabled}"/>
              <Setter Property="Foreground" Value="{StaticResource Ui.TextDisabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
