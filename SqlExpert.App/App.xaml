<Application x:Class="SqlExpert.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SqlExpert.App.Views"
             >
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/CommandMenuTemplates.xaml"/>
        <ResourceDictionary Source="Resources/Branding.xaml"/>
        <ResourceDictionary Source="Themes/Icons.xaml"/>
        <ResourceDictionary Source="Themes/Controls.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="ExplorerBg" Color="#F0F0F0"/>
    <views:ColorMarkBrushConverter x:Key="ColorMarkBrush"/>
    <views:ColorMarkVisibilityConverter x:Key="ColorMarkVisibility"/>
    <SolidColorBrush x:Key="ToolbarBg" Color="#E8E8E8"/>
    <views:IconKeyConverter x:Key="IconKeyToImage"/>
    <!-- Toolbar button that shows one vector icon (views:IconImage); the old caption is the tooltip. -->
    <Style x:Key="IconToolButton" TargetType="Button" BasedOn="{StaticResource FlatIconButton}">
      <Setter Property="Margin" Value="1,0"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Padding" Value="6,3"/>
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
